{
  "manifest_version": 3,
  "name": "BirthdayMessaging",
  "version": "0.1.0",
  "description": "Chrome extension that automates birthday messages using the BirthdayMessaging backend.",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BirthdayMessaging"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.facebook.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://*.facebook.com/*"]
    }
  ],
  "icons": {
    "128": "images/Birthday_messaging-logo.png"
  }
}
