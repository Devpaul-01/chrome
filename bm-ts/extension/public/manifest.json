{
  "manifest_version": 3,
  "name": "BirthdayMessaging",
  "version": "0.1.0",
  "description": "Helps you remember and send personalized birthday wishes to your Facebook friends.",
  "homepage_url": "https://birthdaymessaging.app/privacy",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "notifications", "clipboardWrite"],
  "optional_permissions": ["alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BirthdayMessaging"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/birthdays*",
        "https://www.facebook.com/messages/*",
        "https://www.facebook.com/profile.php*",
        "https://www.facebook.com/friends/birthdays*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.facebook.com/birthdays*",
    "https://www.facebook.com/messages/*",
    "https://www.facebook.com/profile.php*",
    "https://www.facebook.com/friends/birthdays*",
    "http://localhost/*",
    "https://localhost/*",
    "http://*.sslip.io/*",
    "https://*.sslip.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://www.facebook.com/*"]
    }
  ],
  "icons": {
    "16": "images/new-logo/Birthday_messaging-small_icon-white-cake-orange-BG.png",
    "48": "images/new-logo/Birthday_messaging-medium_icon-white-cake-orange-BG.png",
    "128": "images/new-logo/Birthday_messaging-large_icon-white-cake-orange-BG.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
