{
  "manifest_version": 3,
  "name": "BirthdayMessaging",
  "version": "0.1.0",
  "description": "Helps you remember and send personalized birthday wishes to your Facebook friends.",
  "homepage_url": "https://birthdaymessaging.app/privacy",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "notifications",
    "alarms",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BirthdayMessaging"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://*.sslip.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://www.facebook.com/*"]
    }
  ],
  "icons": {
    "128": "images/Birthday_messaging-logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
