# BirthdayMessaging V2 production environment template
# Copy to .env.production on the deployment host and replace every CHANGE_ME value.
# NEVER commit the resulting .env.production file or any real credentials.

POSTGRES_USER=birthdaymessaging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_UNIQUE_DATABASE_PASSWORD
POSTGRES_DB=birthdaymessaging
DATABASE_URL=postgresql+asyncpg://birthdaymessaging:CHANGE_ME_STRONG_UNIQUE_DATABASE_PASSWORD@db:5432/birthdaymessaging

APP_ENVIRONMENT=production
JWT_SECRET_KEY=CHANGE_ME_CRYPTOGRAPHICALLY_RANDOM_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_ENCRYPTION_KEY=CHANGE_ME_VALID_FERNET_KEY
NOTIFICATION_PROVIDER=cloudflare_smtp
CLOUDFLARE_SMTP_HOST=smtp.mx.cloudflare.net
CLOUDFLARE_SMTP_PORT=465
CLOUDFLARE_SMTP_USERNAME=api_token
CLOUDFLARE_SMTP_TIMEOUT_SECONDS=30
CLOUDFLARE_EMAIL_API_TOKEN=CHANGE_ME_CLOUDFLARE_API_TOKEN
SENDGRID_API_KEY=
EMAIL_FROM_NAME=BirthdayMessaging
EMAIL_FROM_ADDRESS=no-reply@birthdaymessaging.com
SUPPORT_EMAIL=support@birthdaymessaging.com
ACCOUNT_URL=https://birthdaymessaging.com
PASSWORD_RESET_URL_BASE=https://birthdaymessaging.com/reset-password
EMAIL_VERIFICATION_URL_BASE=https://birthdaymessaging.com/verify-email

NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_INTERVAL_SECONDS=30
NOTIFICATION_PROCESSING_LEASE_SECONDS=900
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_SHUTDOWN_GRACE_SECONDS=30

BTCPAY_URL=https://btcpay.birthdaymessaging.io
BTCPAY_PUBLIC_URL=https://btcpay.birthdaymessaging.io
BTCPAY_STORE_ID=CHANGE_ME_BTCPAY_STORE_ID
BTCPAY_API_KEY=CHANGE_ME_BTCPAY_API_KEY
BTCPAY_WEBHOOK_SECRET=CHANGE_ME_BTCPAY_WEBHOOK_SECRET
BTCPAY_CURRENCY=USD
BTCPAY_PRICE_MONTHLY=9.70
BTCPAY_PRICE_3_MONTH=29.10
BTCPAY_PRICE_6_MONTH=58.20
BTCPAY_PRICE_YEARLY=97.00
PAYMENT_CHECKOUT_RECOVERY_BATCH_SIZE=50
PAYMENT_CHECKOUT_RECOVERY_INTERVAL_SECONDS=60
PAYMENT_CHECKOUT_RECOVERY_STALE_SECONDS=120

CORS_ORIGINS=["https://birthdaymessaging.com"]
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Legacy/optional Stripe configuration. Leave disabled/empty unless intentionally used.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_REDIRECT_ALLOWED_DOMAINS=[]
