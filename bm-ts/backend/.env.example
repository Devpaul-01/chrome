# BirthdayMessaging V2 development environment template
# Copy to .env and replace placeholders. Never commit real secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=birthdaymessaging
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_LOCAL_ONLY@db:5432/birthdaymessaging

APP_ENVIRONMENT=development
JWT_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_ENCRYPTION_KEY=CHANGE_ME_WITH_VALID_FERNET_KEY
NOTIFICATION_PROVIDER=cloudflare_smtp
CLOUDFLARE_SMTP_HOST=smtp.mx.cloudflare.net
CLOUDFLARE_SMTP_PORT=465
CLOUDFLARE_SMTP_USERNAME=api_token
CLOUDFLARE_EMAIL_API_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM_NAME=BirthdayMessaging
EMAIL_FROM_ADDRESS=
SUPPORT_EMAIL=support@birthdaymessaging.com

BTCPAY_URL=https://btcpay.birthdaymessaging.io
BTCPAY_PUBLIC_URL=https://btcpay.birthdaymessaging.io
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_CURRENCY=USD
BTCPAY_PRICE_MONTHLY=9.70
BTCPAY_PRICE_3_MONTH=29.10
BTCPAY_PRICE_6_MONTH=58.20
BTCPAY_PRICE_YEARLY=97.00
PAYMENT_CHECKOUT_RECOVERY_BATCH_SIZE=50
PAYMENT_CHECKOUT_RECOVERY_INTERVAL_SECONDS=60
PAYMENT_CHECKOUT_RECOVERY_STALE_SECONDS=120

CORS_ORIGINS=["https://birthdaymessaging.com"]
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional Stripe configuration
STRIPE_REDIRECT_ALLOWED_DOMAINS=[]

# Optional isolated concurrency-test database; not required for normal runtime.
CONCURRENCY_DATABASE_URL=
